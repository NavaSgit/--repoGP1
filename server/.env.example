# ===========================================
# Configuración de conexión a SQL Server
# Copia este archivo como ".env" y ajusta si hace falta.
# NO subas el .env al repo.
# ===========================================

# "windows" = Windows Authentication (igual que en SSMS)
# "sql"     = usuario/contraseña de SQL Server
DB_AUTH=windows

# Debe ser IGUAL al "Server name" que usas en SSMS
DB_SERVER=localhost\SQLEXPRESS

# Nombre EXACTO del driver ODBC instalado en Windows.
# Revísalo en: Win+R -> odbcad32.exe -> pestaña "Drivers".
# Ejemplos comunes: "ODBC Driver 17 for SQL Server",
# "ODBC Driver 18 for SQL Server", "SQL Server"
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Nombre de la base de datos ya restaurada
DB_DATABASE=AdventureWorks2008R2

# --- Solo se usan si DB_AUTH=sql ---
DB_USER=sa
DB_PASSWORD=TU_CONTRASENA
DB_PORT=1433
DB_TRUST_SERVER_CERTIFICATE=true

# Puerto en el que corre este backend
PORT=4000
