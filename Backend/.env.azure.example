# ===========================================
# Configuración para conectar el backend a
# AZURE SQL DATABASE (en vez de tu SQL Server local)
# Copia este contenido dentro de tu server/.env
# ===========================================

DB_AUTH=sql

# El nombre completo de tu servidor Azure, ej:
# logingp1-server.database.windows.net
DB_SERVER=TU_SERVIDOR.database.windows.net

DB_DATABASE=AdventureWorks_Azure

# El usuario y contraseña de SQL Authentication que
# definiste al crear el servidor en el portal de Azure
DB_USER=TU_USUARIO
DB_PASSWORD=TU_CONTRASENA

DB_PORT=1433

# Azure SQL Database EXIGE conexión cifrada
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

PORT=4000
